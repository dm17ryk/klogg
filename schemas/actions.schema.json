{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://klogg.dev/schemas/actions.schema.json",
    "title": "KLogg Actions/Responses configuration",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "actions",
        "responses"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Optional schema reference stored in the config file (commonly a relative path)."
        },
        "version": {
            "type": "integer",
            "enum": [
                1,
                3,
                4
            ],
            "description": "Config format version. Versions 1 and 3 are read-compatible; version 4 is written by current builds."
        },
        "actions": {
            "type": "array",
            "default": [],
            "items": {
                "$ref": "#/$defs/action"
            }
        },
        "responses": {
            "type": "array",
            "default": [],
            "items": {
                "$ref": "#/$defs/responseRule"
            }
        }
    },
    "$defs": {
        "hexString": {
            "type": "string",
            "description": "Space-separated bytes as hex pairs, e.g. \"50 61 6E\"",
            "pattern": "^(?:[0-9A-Fa-f]{2})(?:\\s+[0-9A-Fa-f]{2})*$"
        },
        "sequence": {
            "description": "A payload to send (string or hexString).",
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "value"
                    ],
                    "properties": {
                        "type": {
                            "const": "string"
                        },
                        "value": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "value"
                    ],
                    "properties": {
                        "type": {
                            "const": "hexString"
                        },
                        "value": {
                            "$ref": "#/$defs/hexString"
                        }
                    }
                }
            ]
        },
        "match": {
            "description": "A match pattern (string, hexString, or regex).",
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "value"
                    ],
                    "properties": {
                        "type": {
                            "const": "string"
                        },
                        "value": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "value"
                    ],
                    "properties": {
                        "type": {
                            "const": "hexString"
                        },
                        "value": {
                            "$ref": "#/$defs/hexString"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "value"
                    ],
                    "properties": {
                        "type": {
                            "const": "regex"
                        },
                        "value": {
                            "type": "string",
                            "description": "Regex pattern (syntax validated at runtime by the app)."
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "value"
                    ],
                    "properties": {
                        "type": {
                            "const": "wildcard"
                        },
                        "value": {
                            "type": "string",
                            "description": "Wildcard pattern validated at runtime by the app."
                        }
                    }
                }
            ]
        },
        "parameterChoice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "label",
                "value"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "value": {}
            }
        },
        "parameterField": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "type"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "label": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "type": {
                    "enum": [
                        "text",
                        "integer",
                        "decimal",
                        "boolean",
                        "choice",
                        "multi_choice",
                        "date",
                        "time",
                        "date_time",
                        "datetime",
                        "ip_address",
                        "ip",
                        "mac_address",
                        "mac",
                        "phone_number",
                        "phone",
                        "hex_bytes"
                    ]
                },
                "presentation": {
                    "enum": [
                        "auto",
                        "text",
                        "text_box",
                        "combo",
                        "combobox",
                        "combo_box",
                        "radio",
                        "radiobutton",
                        "radio_buttons",
                        "checkboxes",
                        "check_boxes"
                    ]
                },
                "multi_value_mode": {
                    "enum": [
                        "bitwise_or",
                        "comma_separated",
                        "separator",
                        "custom_separator"
                    ]
                },
                "required": {
                    "type": "boolean"
                },
                "sensitive": {
                    "type": "boolean"
                },
                "remember": {
                    "type": "boolean"
                },
                "default": {},
                "minimum": {
                    "type": "number"
                },
                "maximum": {
                    "type": "number"
                },
                "step": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "validation_pattern": {
                    "type": "string"
                },
                "format": {
                    "type": "string"
                },
                "separator": {
                    "type": "string"
                },
                "expression": {
                    "type": "string"
                },
                "choices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/parameterChoice"
                    }
                }
            }
        },
        "actionParameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repeat": {
                    "type": "boolean",
                    "default": false
                },
                "delay": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0
                },
                "repeat_count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                },
                "repeat_interval": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                },
                "variable_names": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/parameterField"
                    }
                }
            }
        },
        "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "enabled",
                "hidden",
                "name"
            ],
            "anyOf": [
                {
                    "required": [
                        "sequence"
                    ]
                },
                {
                    "required": [
                        "expression"
                    ]
                }
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "minimum": 0
                },
                "order": {
                    "type": "integer"
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Stored from JSON; currently not used by app logic."
                },
                "hidden": {
                    "type": "boolean",
                    "description": "If true, action is hidden from the main Actions/Responses window."
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "default": ""
                },
                "sequence": {
                    "$ref": "#/$defs/sequence"
                },
                "expression": {
                    "type": "string",
                    "minLength": 1
                },
                "parameters": {
                    "$ref": "#/$defs/actionParameters"
                },
                "checksum": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "algorithm": {
                            "enum": [
                                "sum8",
                                "crc16_ccitt"
                            ]
                        },
                        "placeholder": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "responseParameterBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source",
                "value"
            ],
            "properties": {
                "source": {
                    "enum": [
                        "literal",
                        "capture",
                        "expression"
                    ],
                    "description": "How the response value is produced at runtime."
                },
                "value": {
                    "description": "Literal value, capture name/index, or action expression."
                }
            }
        },
        "responseStep": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "action_id"
            ],
            "properties": {
                "action_id": {
                    "type": "integer",
                    "minimum": 0
                },
                "delay_ms": {
                    "type": "integer",
                    "minimum": 0
                },
                "parameters": {
                    "type": "object",
                    "additionalProperties": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/responseParameterBinding"
                            },
                            {
                                "not": {
                                    "required": [
                                        "source"
                                    ]
                                }
                            }
                        ]
                    },
                    "description": "Named parameter bindings. Legacy scalar/template values remain supported."
                }
            }
        },
        "responseInstruction": {
            "type": "object",
            "additionalProperties": false,
            "description": "What to do when a response rule matches.",
            "properties": {
                "action_id": {
                    "type": "integer",
                    "minimum": -1,
                    "description": "ID of an Action to send (meaning of special values is app-defined)."
                },
                "action": {
                    "$ref": "#/$defs/sequence",
                    "description": "Inline action payload to send."
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/responseStep"
                    }
                },
                "comment": {
                    "type": "string",
                    "default": ""
                },
                "linebreak": {
                    "type": "boolean",
                    "default": false
                },
                "timestamp": {
                    "type": "boolean",
                    "default": false
                },
                "snapshot": {
                    "type": "boolean",
                    "default": false
                },
                "stop_communication": {
                    "type": "boolean",
                    "default": false
                }
            },
            "allOf": [
                {
                    "not": {
                        "required": [
                            "action_id",
                            "action"
                        ],
                        "description": "Disallow specifying both action_id and inline action at the same time."
                    }
                }
            ]
        },
        "responseRule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "enabled",
                "hidden",
                "name",
                "match",
                "response"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "minimum": 0
                },
                "order": {
                    "type": "integer"
                },
                "enabled": {
                    "type": "boolean",
                    "description": "If true, auto-response is active."
                },
                "hidden": {
                    "type": "boolean",
                    "description": "If true, response rule is hidden from the main Actions/Responses window."
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "default": ""
                },
                "match": {
                    "$ref": "#/$defs/match"
                },
                "response": {
                    "$ref": "#/$defs/responseInstruction"
                }
            }
        }
    }
}
