                      }
                    },
                    {
                      "name": "Device",
                      "format": "match",
                      "regex": "^(?<type>[A-Z]{3,4})(?<index>[0-9])(?<id>[A-Za-z0-9]{5})(?=[A-Z])",
                      "fields": [
                        {
                          "name": "DeviceType",
                          "source": "capture",
                          "capture": "type",
                          "format": "enum",
                          "enumMap": {
                            "ICE": "IntrusionDevice",
                            "SCE": "SafetyDevice",
                            "TCE": "TechnicalDevice"
                          }
                        },
                        {
                          "name": "DeviceIndex",
                          "source": "capture",
                          "capture": "index",
                          "type": "string",
                          "format": "dig"
                        },
                        {
                          "name": "DeviceID",
                          "source": "capture",
                          "capture": "id",
                          "type": "string",
                          "format": "string"
                        }
                      ]
                    },
                    {
                      "name": "Event",
                      "format": "match",
                      "regex": "^(?<code>[A-Z]+)(?<params>.*)$",
                      "fields": [
                        {
                          "name": "Code",
                          "source": "capture",
                          "capture": "code",
                          "format": "enum",
                          "enumMap": {
                            "DIPR": "DeviceInitParamRequest",
                            "NIPR": "NetworkInitParamRequest"
                          }
                        },
                        {
                          "name": "Parameters",
                          "source": "capture",
                          "capture": "params",
                          "type": "string",
                          "format": "string"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "name": "checksum",
              "source": "capture",
              "capture": "checksum",
              "type": "hexString",
              "format": "hex"
            }
          ]
        }
      ]
    }
  ]
}
