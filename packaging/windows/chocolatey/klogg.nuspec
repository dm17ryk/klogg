    <title>klogg - the fast, smart log explorer</title>
    <authors>Nicolas Bonnefon, Anton Filimonov, Dmitry Kokotov</authors>
    <projectUrl>https://github.com/dm17ryk/klogg</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/dm17ryk/klogg/master/Resources/klogg.ico</iconUrl>
